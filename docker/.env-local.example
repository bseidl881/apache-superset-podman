# -----------------------------------------------------------------------
# Example .env-local file for running multiple Superset instances
# Copy this file to .env-local and customize for your setup
# -----------------------------------------------------------------------

# Unique project name prevents container/volume conflicts between clones
# Each clone should have a different name (e.g., superset-pr123, superset-feature-x)
COMPOSE_PROJECT_NAME=superset-dev2

# Port offsets for running multiple instances simultaneously
# Instance 1 (default): 80, 8088, 9000, 8080, 8081, 5432, 6379
# Instance 2 example:   81, 8089, 9001, 8082, 8083, 5433, 6380
NGINX_PORT=81
SUPERSET_PORT=8089
NODE_PORT=9001
WEBSOCKET_PORT=8082
DATABASE_PORT=5433
REDIS_PORT=6380

# For verbose logging during development:
# SUPERSET_LOG_LEVEL=debug

# Optional external PostgreSQL metadata DB instead of the bundled `db` service.
# Works for local host PostgreSQL, a remote VM, EC2, or Amazon RDS.
# For Podman on Windows, `host.containers.internal` usually reaches services
# running on the host. For Docker, `host.docker.internal` is the typical value.
# To disable the bundled Postgres container entirely, start Compose with:
#   podman compose -f docker-compose-non-dev.yml -f docker-compose-non-dev.external-db.yml up --build
# DATABASE_DIALECT=postgresql
# DATABASE_HOST=host.containers.internal
# DATABASE_PORT=5432
# DATABASE_DB=superset
# DATABASE_USER=superset
# DATABASE_PASSWORD=change-me

# Optional examples DB connection. Only relevant when loading example data.
# EXAMPLES_HOST=host.containers.internal
# EXAMPLES_PORT=5432
# EXAMPLES_DB=examples
# EXAMPLES_USER=examples
# EXAMPLES_PASSWORD=change-me

# Optional host directory with SQLite database files mounted into the
# containers at /app/sqlite. Example on Windows/Podman: SQLITE_FILES_DIR=./local_sqlite
# SQLite SQLAlchemy URIs can then use paths like sqlite:////app/sqlite/my.db
# SQLITE_FILES_DIR=./local_sqlite
# To run Superset itself on SQLite for a short-lived PoC, start Compose with:
#   podman compose -f docker-compose-non-dev.yml -f docker-compose-non-dev.sqlite.yml up --build
# Optional explicit overrides:
# SUPERSET__SQLALCHEMY_DATABASE_URI=sqlite:////app/sqlite/superset.db?check_same_thread=false
# SUPERSET__SQLALCHEMY_EXAMPLES_URI=sqlite:////app/sqlite/examples.db?check_same_thread=false
